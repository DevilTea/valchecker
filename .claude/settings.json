{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"allow": [
			"Bash(git status:*)",
			"Bash(git diff:*)",
			"Bash(git log:*)",
			"Bash(git show:*)",
			"Bash(git branch)",
			"Bash(git branch --list:*)",
			"Bash(git branch -v:*)",
			"Bash(git branch -vv:*)",
			"Bash(git branch -r:*)",
			"Bash(git branch -a:*)",
			"Bash(git switch:*)",
			"Bash(git fetch:*)",
			"Bash(git worktree list)",
			"Bash(git stash list)",
			"Bash(git rev-parse:*)",
			"Bash(git rev-list:*)",
			"Bash(git merge-base:*)",
			"Bash(git for-each-ref:*)",
			"Bash(git ls-remote:*)",
			"Bash(git check-ignore:*)",
			"Bash(git patch-id:*)",
			"Bash(git bundle create:*)",
			"Bash(git bundle verify:*)",
			"Bash(git push --dry-run:*)",
			"Bash(git clean -n:*)",
			"Bash(git clean --dry-run:*)",
			"Bash(git add:*)",
			"Bash(git commit:*)",
			"Bash(gh pr view:*)",
			"Bash(gh pr diff:*)",
			"Bash(gh pr list:*)",
			"Bash(gh pr checks:*)",
			"Bash(gh issue view:*)",
			"Bash(gh issue list:*)",
			"Bash(gh run list:*)",
			"Bash(gh run view:*)",
			"Bash(pnpm install --frozen-lockfile)",
			"Bash(pnpm verify)",
			"Bash(pnpm build)",
			"Bash(pnpm stub)",
			"Bash(pnpm lint)",
			"Bash(pnpm lint:fix)",
			"Bash(pnpm typecheck)",
			"Bash(pnpm typeperf)",
			"Bash(pnpm publint)",
			"Bash(pnpm test)",
			"Bash(pnpm test:*)",
			"Bash(pnpm bench)",
			"Bash(pnpm bench:*)",
			"Bash(pnpm api:surface)",
			"Bash(pnpm api:surface:update)",
			"Bash(pnpm docs:build)",
			"Bash(pnpm docs:examples)",
			"Bash(pnpm release:readiness)",
			"Bash(pnpm release:validate)",
			"Bash(pnpm --dir benchmarks *)"
		],
		"deny": [
			"Bash(npm publish:*)",
			"Bash(pnpm publish:*)",
			"Bash(pnpm release:publish:*)",
			"Bash(git commit --no-verify:*)",
			"Read(./.env)",
			"Read(./.env.*)"
		]
	}
}
