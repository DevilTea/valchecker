{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"allow": [
			"Bash(pnpm install --frozen-lockfile)",
			"Bash(pnpm verify)",
			"Bash(pnpm build)",
			"Bash(pnpm stub)",
			"Bash(pnpm lint)",
			"Bash(pnpm lint:fix)",
			"Bash(pnpm typecheck)",
			"Bash(pnpm typeperf)",
			"Bash(pnpm publint)",
			"Bash(pnpm test)",
			"Bash(pnpm test:*)",
			"Bash(pnpm bench)",
			"Bash(pnpm bench:*)",
			"Bash(pnpm api:surface)",
			"Bash(pnpm api:surface:update)",
			"Bash(pnpm docs:build)",
			"Bash(pnpm release:readiness)",
			"Bash(pnpm release:validate)",
			"Bash(pnpm --dir benchmarks *)",
			"Bash(git status:*)",
			"Bash(git diff:*)",
			"Bash(git log:*)",
			"Bash(git show:*)",
			"Bash(git branch:*)",
			"Bash(git switch:*)",
			"Bash(git worktree list)",
			"Bash(gh pr view:*)",
			"Bash(gh pr diff:*)",
			"Bash(gh pr list:*)",
			"Bash(gh pr checks:*)",
			"Bash(gh issue view:*)",
			"Bash(gh issue list:*)",
			"Bash(gh run list:*)",
			"Bash(gh run view:*)"
		],
		"deny": [
			"Bash(git push:*)",
			"Bash(git tag:*)",
			"Bash(git reset --hard:*)",
			"Bash(git checkout --:*)",
			"Bash(git clean:*)",
			"Bash(git commit --no-verify:*)",
			"Bash(git worktree remove:*)",
			"Bash(git worktree prune:*)",
			"Bash(gh workflow run:*)",
			"Bash(gh release:*)",
			"Bash(npm publish:*)",
			"Bash(pnpm publish:*)",
			"Bash(pnpm release:publish:*)",
			"Read(./.env)",
			"Read(./.env.*)"
		]
	}
}
